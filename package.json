{
  "name": "roblox-update-tracker",
  "version": "1.0.0",
  "description": "Roblox Update Tracker Discord bot with configurable update alerts.",
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x || 26.x"
  },
  "main": "index.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc && node -e \"console.log('Build completed successfully.')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/lib/registerCommands.ts"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/node-fetch": "^2.6.13",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2"
  }
}
